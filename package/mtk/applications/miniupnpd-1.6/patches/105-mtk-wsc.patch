+/*	$Id: //WIFI_SOC/TRUNK/RT288x_SDK/source/user/miniupnpd-1.6/ifaddrs.c#2 $	*/
+/* 	from USAGI: ifaddrs.c,v 1.20.2.1 2002/12/08 08:22:23 yoshfuji Exp */
