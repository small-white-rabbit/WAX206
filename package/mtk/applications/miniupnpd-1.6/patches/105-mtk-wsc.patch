+int xml_print(const char *s, int len, FILE *f)
+{
+	int n = 0, i;
+	int elt_close = 0;
+	int c, indent = 0;
+
+	while (len > 0)
+	{
+		c = *(s++);
+		len--;
+		switch (c)
+		{
+		case '<':
+			if (len > 0 && *s == '/')
+				elt_close++;
+			else if (len > 0 && *s == '?')
+				elt_close = 1;
+			else
+				elt_close = 0;
+			if (elt_close != 1)
+			{
+				if (elt_close > 1)
+					indent--;
+				fputc('\n', f);
+				n++;
+				for (i = indent; i > 0; i--)
+					fputc(' ', f);
+				n += indent;
+			}
+			fputc(c, f);
+			n++;
+			break;
+		case '>':
+			fputc(c, f);
+			n++;
+			if (elt_close == 1)
+			{
+				/*fputc('\n', f); n++; */
+				//elt_close = 0;
+				if (indent > 0)
+					indent--;
+			}
+			else if (elt_close == 0)
+				indent++;
+			break;
+		default:
+			fputc(c, f);
+			n++;
+		}
+	}
+	return n;
+}
