 		while(*p==' ') p++;
-		data->opackets = strtoul(p, &p, 0);
+		data->opackets = strtoull(p, &p, 0) % 0xffffffff;
 		r = 0;
 		break;
 	}
diff --git a/minissdp.c b/minissdp.c
index 89d9f45..c903d10 100644
--- a/minissdp.c
+++ b/minissdp.c
@@ -31,7 +31,9 @@
 #include "asyncsendto.h"
 #include "codelength.h"
 #include "macros.h"
-
+#ifdef ENABLE_WSC_SERVICE
+#include "wsc/wsc_common.h"
+#endif /* ENABLE_WSC_SERVICE */
 /* SSDP ip/port */
 #define SSDP_PORT (1900)
 #define SSDP_MCAST_ADDR ("239.255.255.250")
@@ -456,6 +458,51 @@ SendSSDPResponse(int s, const struct sockaddr * addr,
 	char addr_str[64];
 	socklen_t addrlen;
 	int st_is_uuid;
+#ifdef ENABLE_WSC_SERVICE
+	if (port == WPS_PORT)
+	{
+		/* 
+		 * follow guideline from document "UPnP Device Architecture 1.0"
+		 * uppercase is recommended.
+		 * DATE: is recommended
+		 * SERVER: OS/ver UPnP/1.0 miniupnpd/1.0
