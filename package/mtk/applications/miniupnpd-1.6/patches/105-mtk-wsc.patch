+/******************************************************************************
+ * WscDevCPListRemoveAll
+ *
+ * Description: 
+ *   Remove all Control Point Node in WscCPList
+ *
+ * Parameters:
+ *   None
+ *
+ * Return:
+ *   TRUE
+ *****************************************************************************/
+static int WscDevCPListRemoveAll(void)
+{
+	struct upnpCPNode *CPNode;
+
+	while((CPNode = WscCPList))
+	{
+		WscCPList = CPNode->next;
+		free(CPNode);
+	}
+	
+	return TRUE;
+}
