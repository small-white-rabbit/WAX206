+#define WSC_UPNP_DATA_SUB_M2D			0x06
+#define WSC_UPNP_DATA_SUB_M3			0x07
+#define WSC_UPNP_DATA_SUB_M4			0x08
+#define WSC_UPNP_DATA_SUB_M5			0x09
+#define WSC_UPNP_DATA_SUB_M6			0x0A
