+	{
+		printf("\n===StartOfMsgCharDump:%s\n", title);
+		for(i = 0; i < len; i++)
+		{
+			printf("%c", tmp[i] & 0xff);
+		}
+		printf("\n===EndOfMsgCharDump!\n");
+	}
+
+	return;
+}
