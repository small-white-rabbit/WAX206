+void wsc_hexdump(char *title, char *ptr, int len)
+{
+
+	int32 i;
+	char *tmp = ptr;
+
+	if (RT_DBG_PKT <= wsc_debug_level)
+	{
+		printf("\n---StartOfMsgHexDump:%s\n", title);
+		for(i = 0; i < len; i++)
+		{
+			if(i%16==0 && i!=0)
+				printf("\n");
+			printf("%02x ", tmp[i] & 0xff);
+		}
+		printf("\n---EndOfMsgHexDump!\n");
+	}
+
+	return;
+}
