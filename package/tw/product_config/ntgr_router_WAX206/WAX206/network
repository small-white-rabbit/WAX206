
config interface 'loopback'
	option ifname 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config interface 'lan'
	option type 'bridge'
	option ifname 'eth0.0'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'
	option ip6assign '60'

config device 'lan_dev'
	option name 'eth0.0'

config interface 'wan'
	option ifname 'eth0.4095'
	option proto 'dhcp'
	option disabled '0'
	option ipv6 '0'
	option demand '300'
	option keepalive '3 10'

config device 'wan_dev'
	option name 'eth0.4095'

config interface 'wan6'
	option ifname 'eth0.4095'
	option proto 'dhcpv6'
	option disabled '1'

config switch
	option name 'switch0'
	option reset '1'
	option enable_vlan '1'

config switch_vlan
	option device 'switch0'
	option vlan '0'
	option ports '1 2 3 4 6t'

config switch_vlan
	option device 'switch0'
	option vlan '4095'
	option ports '0 5 6t'

