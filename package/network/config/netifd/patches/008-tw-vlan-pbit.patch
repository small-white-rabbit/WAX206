@@ -455,6 +456,7 @@
 	dev = device_get(name, true);
 	if (!dev)
 		return;
+	dev->priority = bst->priority;
 
 	bridge_create_member(bst, name, dev, false);
 }
@@ -549,6 +551,7 @@
 	}
 
 	bst->n_failed = 0;
+	bst->priority = dev->priority;
 	vlist_update(&bst->members);
 	if (bst->ifnames) {
 		blobmsg_for_each_attr(cur, bst->ifnames, rem) {

