 };
 
 struct device_hotplug_ops {
diff --git a/interface.c b/interface.c
index a014111..3bdf7b5 100644
--- a/interface.c
+++ b/interface.c
@@ -46,6 +46,7 @@ enum {
 	IFACE_ATTR_DELEGATE,
 	IFACE_ATTR_IP6IFACEID,
 	IFACE_ATTR_FORCE_LINK,
+	IFACE_ATTR_PRIORITY,    //802.1P  jiangdingyong modify 20200411
 	IFACE_ATTR_MAX
 };
 
@@ -68,6 +69,7 @@ static const struct blobmsg_policy iface_attrs[IFACE_ATTR_MAX] = {
 	[IFACE_ATTR_DELEGATE] = { .name = "delegate", .type = BLOBMSG_TYPE_BOOL },
 	[IFACE_ATTR_IP6IFACEID] = { .name = "ip6ifaceid", .type = BLOBMSG_TYPE_STRING },
 	[IFACE_ATTR_FORCE_LINK] = { .name = "force_link", .type = BLOBMSG_TYPE_BOOL },
+	[IFACE_ATTR_PRIORITY] = { .name = "priority", .type = BLOBMSG_TYPE_INT32 }, //802.1P  jiangdingyong modify 20200411
 };
 
 const struct uci_blob_param_list interface_attr_list = {
@@ -883,6 +885,10 @@ static bool __interface_add(struct interface *iface, struct blob_attr *config, b
 	} else {
 		if ((cur = tb[IFACE_ATTR_IFNAME]))
 			iface->ifname = blobmsg_data(cur);
+		//802.1P  jiangdingyong modify 20200411  start
+		if ((cur = tb[IFACE_ATTR_PRIORITY]))
+			iface->priority = blobmsg_get_u32(cur);
+		//802.1P  jiangdingyong modify 20200411  end
 	}
 
 	iface->config = config;
@@ -949,6 +955,14 @@ interface_set_main_dev(struct interface *iface, struct device *dev)
 			return;
 	}
 
+	//802.1P  jiangdingyong modify 20200411  start
+	//netifd_log_message(L_CRIT, "[jdy][%s][%d] iface->priority=%d \n", __FUNCTION__, __LINE__, iface->priority);
+	if (iface->main_dev.dev)
+	{
+		iface->main_dev.dev->priority = iface->priority;
+	}
+	//802.1P  jiangdingyong modify 20200411  end
+
 	if (!iface->l3_dev.dev)
 		interface_set_l3_dev(iface, dev);
 }
diff --git a/interface.h b/interface.h
index 7d5b309..c3246ea 100644
--- a/interface.h
+++ b/interface.h
@@ -164,6 +164,7 @@ struct interface {
 
 	struct uloop_timeout remove_timer;
 	struct ubus_object ubus;
+	unsigned int priority; //802.1P  jiangdingyong modify 20200411
 };
 
 
diff --git a/system-linux.c b/system-linux.c
index bdea345..8c2990e 100644
--- a/system-linux.c
+++ b/system-linux.c
@@ -1133,6 +1133,7 @@ int system_macvlan_del(struct device *macvlan)
 
 static int system_vlan(struct device *dev, int id)
 {
+	int rv = 0;
 	struct vlan_ioctl_args ifr = {
 		.cmd = SET_VLAN_NAME_TYPE_CMD,
 		.u.name_type = VLAN_NAME_TYPE_RAW_PLUS_VID_NO_PAD,
@@ -1148,7 +1149,23 @@ static int system_vlan(struct device *dev, int id)
 		ifr.u.VID = id;
 	}
 	strncpy(ifr.device1, dev->ifname, sizeof(ifr.device1));
-	return ioctl(sock_ioctl, SIOCSIFVLAN, &ifr);
+	rv = ioctl(sock_ioctl, SIOCSIFVLAN, &ifr);
+	if (0 == rv && id >= 0 && dev->priority != 0)
+	{
+		int i = 0;
+		for (i = 0; i <= 7; i++)
+		{
+			struct vlan_ioctl_args pr = {
+				.cmd = SET_VLAN_EGRESS_PRIORITY_CMD,
+				.u.skb_priority = i,
+				.vlan_qos = dev->priority,
+			};
+			snprintf(pr.device1, sizeof(pr.device1), "%s.%u", dev->ifname, id);
+			ioctl(sock_ioctl, SIOCSIFVLAN, &pr);
+		}
+	}
+
+	return rv;
 }
 
 static int mtkhnat_update_ppddev(char *ifname, int id)
