+static int dnshijack_inetaddr_event(struct notifier_block *this, unsigned long event, void *ptr)
+{
+    struct in_ifaddr *ifa = (struct in_ifaddr *) ptr;
+    struct net_device *dev = ifa->ifa_dev->dev;
+
+    if (dev && !strcmp(dev->name, "br-lan"))
+    {
+        if (event == NETDEV_UP && (0 == strcmp(dev->name, ifa->ifa_label)))
+        {
+            netgear_dns_hijackip = ifa->ifa_address;
+        }
+        else if (event == NETDEV_DOWN)
+        {
+            ; // ignore
+        }
+    }
+
+    return NOTIFY_OK;
+}
