+    //printk("[%s][%d] domain=[%s]\n", __FUNCTION__, __LINE__, domain);
+
+    while( (*domain) && ( strCnt < 20 ))
+    {
+        strCnt++;
+        len = *domain;
+        domain++;
+        if(len & 0xC0)
+        {
+            break;
+            return -1;
+        }
+        else{
+            if((dnsBufCnt + len) > dnsBufLen)
+            {
+                break;
+            }
+            
+            //printk("[%s][%d] domain=[%s]\n", __FUNCTION__, __LINE__, domain);
+
+            for( j = 0; j<len ; j++)
+            {
+                dnsBuf[dnsBufCnt] = *domain;
+                domain++;
+                dnsBufCnt++;
+            }
+            dnsBuf[dnsBufCnt] = '.';
+            dnsBufCnt++;
+        }
+    }
+
+    if(dnsBuf[dnsBufCnt-1] == '.')
+        dnsBuf[dnsBufCnt-1] = 0;  //remove last '.'
+
+    strDownCase(dnsBuf);
+    //printk("[%s][%d] dnsBuf=[%s]\n", __FUNCTION__, __LINE__, dnsBuf);
+    return 1;
+}
