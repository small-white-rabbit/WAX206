+static int br_dns_netgearresponse(struct sk_buff *skb,u_int32_t  dns_ttl)
+{
+    struct sk_buff *newskb = NULL;
+    struct ethhdr *eth = NULL;
+    struct iphdr *iph = NULL;
+    struct ipv6hdr *ipv6h = NULL;
+    struct ethhdr *neweth = NULL;
+    struct ipv6hdr *newipv6h = NULL;
+    struct iphdr *newiph = NULL;
+    struct udphdr *udph = NULL;
+    struct udphdr *newudph = NULL;
+    u_int32_t udplen, newlen, newudplen;
+    u_int32_t maxQueryLen = 0;
+    u_int32_t domainLen = 0;
+    unsigned int dnsanSize = 0;
+    struct dns_header *dns_hdr = NULL;
+    unsigned char *dns_query = NULL;
+    unsigned int *tol = NULL;
+    unsigned short *dl = NULL;
+    __be32 *anip = NULL;
+    struct in6_addr *anip6 = NULL;
+    unsigned char *dns_response = NULL;
+    unsigned int query_size = 0;
+    unsigned char isIpv4 = 0;
+    unsigned char dns_type = 0;
+    unsigned char isApple = 0;
+
+    /* caculate new UDP packet length */
+    eth = eth_hdr(skb);
+    if (eth->h_proto == htons(ETH_P_IP))
+    {
+        isIpv4 = 1;
+        iph = (struct iphdr *)skb_network_header(skb);
+        udph = (struct udphdr *)(((unsigned char *)iph) + (iph->ihl<<2));
+    }
+    else if (eth->h_proto == htons(ETH_P_IPV6))
+    {
+        isIpv4 = 0;
+        ipv6h = (struct ipv6hdr *)skb_network_header(skb);
+        udph = (struct udphdr *)((unsigned char *)ipv6h + sizeof(struct ipv6hdr));//ipv6 header's fixed-lenght is 40
+    }
+
+    dns_hdr = (struct dns_header *)((unsigned char *)udph + sizeof(struct udphdr));
+    dns_query = (unsigned char *)dns_hdr + sizeof(struct dns_header);
+    domainLen = dns_query_name_sizeof((unsigned char *)dns_query);
+    udplen = ntohs(udph->len);
+    maxQueryLen = udplen - sizeof(struct udphdr) - sizeof(struct dns_header) - 4;
+    if (domainLen > maxQueryLen)
+    {
+        return 0;
+    }
+    isApple = isApple_google_domain(dns_query, domainLen);
+
+    if (htons(*(short *) (dns_query + domainLen)) == 0x0001
+            && htons(*(short *) (dns_query + domainLen + 2)) == 0x0001)
+    {
+        dns_type = 0; /*ipv4*/
+        dnsanSize = domainLen + 10 + 4;
+    }
+    else if (htons(*(short *) (dns_query + domainLen))== 0x001c
+            && htons(*(short *) (dns_query + domainLen + 2)) == 0x0001)
+    {
+        dns_type = 1; /*ipv6 */
+        dnsanSize = domainLen + 10 + 16;
+    }
+    else
+    {
+        dns_type = 2; /*others */
+        dnsanSize = 0;
+    }
+
+    if (isApple == 1)
+    {
+        dns_type = 2; /*others */
+        dnsanSize = 0;
+    }
+
+    newudplen = udplen + dnsanSize;
+
+    if (isIpv4)
+    {
+        newlen = iph->ihl*4 + newudplen;
+    }
+    else
+    {
+        newlen = sizeof(struct ipv6hdr) + newudplen;
+    }
+
+    skb_push(skb, ETH_HLEN);
+    newskb = skb_copy_expand(skb, skb_headroom(skb), dnsanSize, GFP_ATOMIC);
+    skb_pull(skb, ETH_HLEN);
+
+    if (NULL == newskb)
+    {
+        return 0;
+    }
+
+    skb_put(newskb, dnsanSize);
+
+    /* reverse destinate MAC and source MAC*/
+    neweth = eth_hdr(newskb);
+    memcpy(neweth->h_source, eth->h_dest, ETH_ALEN);
+    memcpy(neweth->h_dest, eth->h_source, ETH_ALEN);
+
+    /* reverse destinate IP and source IP */
+    if (isIpv4)
+    {
+        /* reverse destinate IP and source IP */
+        newiph = (struct iphdr *)skb_network_header(newskb);
+        newiph->saddr = iph->daddr;
+        newiph->daddr = iph->saddr;
+
+        /*modify the rest of IP packet values */
+        newiph->tot_len = htons(newlen);
+        newiph->id = 0;
+        newiph->frag_off = htons(0x4000); // do not fragment
+        newiph->ttl = 64;
+
+        newudph = (void *)newiph + newiph->ihl*4;
+    }
+    else
+    {
+        newipv6h = (struct ipv6hdr *)skb_network_header(newskb);
+        newipv6h->saddr = ipv6h->daddr;
+        newipv6h->daddr = ipv6h->saddr;
+        newipv6h->payload_len = htons(newudplen);
+        newudph = (void *)newipv6h + sizeof(struct ipv6hdr);
+    }
+
+    /* modify UDP packet values */
+    newudph->source = udph->dest;
+    newudph->dest = udph->source;;
+    newudph->len = htons(newudplen);
+
+    /*modify DNS packet values */
+    dns_hdr = (struct dns_header *)((unsigned char *)newudph + sizeof(struct udphdr));
+    if ((0 == dns_type) || (1 == dns_type))
+    {
+        dns_hdr->flags = htons(0x8180); // standard query response, no error
+        dns_hdr->ancount = htons(1);
+    }
+    else
+    {
+        dns_hdr->flags = htons(0x8185); // Refused 8185 for AAA type
+        dns_hdr->ancount = htons(0);
+    }
+
+    /* add DNS answer */
+    if (0 == dns_type)
+    {
+        query_size = dnsanSize - (6 + 4);
+        dns_query = (unsigned char *)dns_hdr + sizeof(struct dns_header);
+        dns_response = (unsigned char *)dns_query + query_size;
+        memcpy(dns_response, dns_query, dnsanSize);
+        tol = (unsigned int *)(dns_response + query_size);
+        *tol = htonl(dns_ttl);
+        dl    = (unsigned short *)(dns_response + query_size + 4);
+        *dl   = htons(4);
+        anip  = (__be32 *)(dns_response + query_size + 6);
+        *anip = (__be32)(netgear_dns_hijackip); //force to the LAN Manage IP
+    }
+    else if (1 == dns_type)
+    {
+        query_size = dnsanSize - (6 + 16);
+        dns_query = (unsigned char *)dns_hdr + sizeof(struct dns_header);
+        dns_response = (unsigned char *)dns_query + query_size;
+        memcpy(dns_response, dns_query, dnsanSize);
+        tol = (unsigned int *)(dns_response + query_size);
+        *tol = htonl(dns_ttl);
+        dl    = (unsigned short *)(dns_response + query_size + 4);
+        *dl   = htons(16);
+        anip6  = (struct in6_addr *)(dns_response + query_size + 6);
+        *anip6 = netgear_dns_hijackip6; //force to the LAN Manage IP
+    }
+
+    if (isIpv4)
+    {
+        if (newudph->check != 0)
+        {
+            newudph->check = 0;
+            newudph->check = csum_tcpudp_magic(newiph->saddr, newiph->daddr,
+                                                    newudplen, IPPROTO_UDP,
+                                                    csum_partial((char *)newudph,newudplen, 0));
+        }
+        ip_send_check(newiph); //ip checksum
+    }
+    else
+    {
+        if (newudph->check != 0)
+        {
+            newudph->check = 0;
+            newudph->check = csum_ipv6_magic(&newipv6h->saddr, &newipv6h->daddr,
+                                                newudplen, IPPROTO_UDP,
+                                                csum_partial((char *)newudph,newudplen, 0));
+            if (newudph->check == 0)
+                newudph->check = CSUM_MANGLED_0;
+        }
+    }
+
+    if (newskb->dev != NULL
+                && newskb->dev->netdev_ops != NULL
+                && newskb->dev->netdev_ops->ndo_start_xmit != NULL)
+    {
+        newskb->dev->netdev_ops->ndo_start_xmit(newskb, newskb->dev);
+    }
+
+    return 1;
+}
+
+static int br_dns_netgearfilter(struct sk_buff *skb)
+{
+    struct ethhdr *eth     = (struct ethhdr *)skb_mac_header(skb);
+    struct iphdr *iph        = NULL;
+    struct ipv6hdr *ipv6h = NULL;
+    struct udphdr *udph  = NULL;
+    char *queryph           = NULL;
+    struct dns_header *dnsph = NULL;
+    int udplen = 0;
+    int queryslen = 0;
+    int i = 0;
+    int len = 0;
+    char *domain = NULL;
+    char maindomain[] ={0x03,'w','w','w'};
+    char netGearDomain[] = {0x0b,'r','o','u','t','e','r','l','o','g','i','n'};
+    char netGearDomain3[] = {0x03,'c','o','m','\0'};
+    char netGearDomain4[] = {0x03,'n','e','t','\0'};
+
+    if (eth->h_proto != htons(ETH_P_IP)  && eth->h_proto != htons(ETH_P_IPV6))
+    {
+        return 1;
+    }
+
+    if (eth->h_proto == htons(ETH_P_IP))
+    {
+        iph = (struct iphdr *) skb->data;
+        if (iph->protocol != 17)
+        {
+            return 1;
+        }
+        udph = (struct udphdr *)(((unsigned char *)iph) + (iph->ihl<<2));
+    }
+    else if (eth->h_proto == htons(ETH_P_IPV6))
+    {
+        ipv6h = (struct ipv6hdr *) skb->data;
+        if (ipv6h->nexthdr != 17)
+        {
+            return 1;
+        }
+        udph = (struct udphdr *)((unsigned char *)ipv6h + sizeof(struct ipv6hdr));//ipv6 header's fixed-lenght is 40
+    }
+
+    if (udph->dest != ntohs(53))
+    {
+        return 1;
+    }
+
+    udplen = ntohs(udph->len);
+#if 0
+    /*TBD data header point ip header*/
+	if (udplen > (skb->tail - skb->data))
+    {
+        return 1;
+    }
+#endif
+    if (udplen <= sizeof(struct udphdr) + sizeof(struct dns_header))
+    {
+        return 1;
+    }
+
+    dnsph = (struct dns_header *) ((char *)udph + sizeof(struct udphdr));
+    /*filter dns query*/
+    if (ntohs(dnsph->flags) & 0xF800)
+    {
+        return 1;
+    }
+
+    if (dnsph->qdcount <= 0)
+    {
+        return 1;
+    }
+
+    if (netgear_dns_hijack == 2)
+    {
+        return 0;
+    }
+
+    queryph = (char *) ((char *)dnsph + sizeof(struct dns_header));
+    queryslen = udplen - sizeof(struct udphdr) - sizeof(struct dns_header);
+    domain = queryph;
+    for (i = 0; i < ntohs(dnsph->qdcount); i++)
+    {
+        if (strncasecmp(domain, maindomain, sizeof(maindomain)) == 0)
+        {
+            domain += sizeof(maindomain);
+            len += sizeof(maindomain);
+        }
+
+        if (strncasecmp(domain, netGearDomain, sizeof(netGearDomain)) == 0)
+        {
+            domain += sizeof(netGearDomain);
+            len += sizeof(netGearDomain);
+
+			if ((strncasecmp(domain, netGearDomain3, sizeof(netGearDomain3)) == 0) || 
+				((strncasecmp(domain, netGearDomain4, sizeof(netGearDomain4)) == 0)))
+			{
+				domain += strlen(domain) + 1;
+				len += strlen(domain) + 1;
+				if ((len + 4 <= queryslen)
+						&& htons((*(short *) (domain))) == 0x0001
+						&& (htons(*(short *) (domain + 2))) == 0x0001)
+				{
+					return 0;
+				}
+				else
+				{
+					return 0;
+				}
+			}
+        }
+        /*only compare the first query TBD*/
+        break;
+    }
+    return 1;
+}
+
+int br_dns_netgear(struct sk_buff *skb)
+{
+    if (netgear_dns_hijack == 0)
+    {
+        return 1;
+    }
+
+    if (0 == br_dns_netgearfilter(skb))
+    {
+        br_dns_netgearresponse(skb, DNS_TTL);
+        return 0;
+    }
+    return 1;
+}
