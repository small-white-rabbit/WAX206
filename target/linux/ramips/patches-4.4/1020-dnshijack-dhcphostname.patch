+/*************************************
+ * fuction: br_dhcp_packet
+ * input: udp data, dhcp option code
+ * return:code offset at skb
+ *************************************/
+int br_dhcp_packet(struct sk_buff *skb, unsigned char *br_dest, const unsigned char *dest)
+{
+    struct iphdr *iph = NULL;
+    struct udphdr *udph = NULL;
+    struct udp_dhcp_packet *dhcp_packet = NULL;
+    unsigned char option_len = 0, *temp = NULL;
+    struct device_list_table g_deviceListTable;
+
+    if ((NULL == skb) || (NULL == br_dest) || (NULL == dest))
+    {
+        return 0;
+    }
+
+    iph = (struct iphdr *)skb_network_header(skb);
+
+    if(NULL == iph)
+    {
+        return 0;
+    }
+
+    udph=(void *) iph + iph->ihl*4;
+    if(NULL == udph)
+    {
+        return 0;
+    }
+
+    if(iph->protocol == IPPROTO_UDP)
+    {
+        if(ntohs(udph->dest) == 67)
+        {
+            dhcp_packet =(struct udp_dhcp_packet *)skb->data;
+            if(NULL == dhcp_packet)
+            {
+                return 0;
+            }
+
+            if(0x01 == dhcp_packet->data.op)
+            {
+                if (NULL != (temp = br_get_dhcp_option(&(dhcp_packet->data), DHCP_HOST_NAME, &option_len)))
+                {
+                    memset(&g_deviceListTable, 0, sizeof(struct device_list_table));
+                    memcpy(g_deviceListTable.mac, dhcp_packet->data.chaddr, 6);
+                    memcpy(g_deviceListTable.ifname, skb->dev->name, sizeof(skb->dev->name) < sizeof(g_deviceListTable.ifname) ? sizeof(g_deviceListTable.ifname) : sizeof(skb->dev->name) );
+                    if(option_len < 64)
+                    {
+                        memcpy(g_deviceListTable.hostname, temp, option_len);
+                    }
+                    if (NULL != (temp = br_get_dhcp_option(&(dhcp_packet->data), DHCP_REQUESTED_IP, &option_len)))
+                    {
+                        memcpy(g_deviceListTable.ip, temp, 4);
+                    }
+                    g_deviceListTable.ifindex = skb->dev->ifindex;
+                    g_deviceListTable.pkttype = 0;
+                    send_msg_to_user(g_deviceListTable);
+                }
+            }
+        }
+        else if(ntohs(udph->dest) == 68)
+        {
+            dhcp_packet =(struct udp_dhcp_packet *)skb->data;
+            if(NULL == dhcp_packet)
+            {
+                return 0;
+            }
+
+            if(0x02 == dhcp_packet->data.op)
+            {
+                if (NULL != (temp = br_get_dhcp_option(&(dhcp_packet->data), DHCP_PKT_TYPE, &option_len)))
+                {
+                    if (temp[0] == 0x05)
+                    {
+                        memset(&g_deviceListTable, 0, sizeof(struct device_list_table));
+                        memcpy(g_deviceListTable.mac, dhcp_packet->data.chaddr, 6);
+                        g_deviceListTable.pkttype = 5;
+                        g_deviceListTable.ip[0] = (dhcp_packet->data.yiaddr[0]);
+                        g_deviceListTable.ip[1] = (dhcp_packet->data.yiaddr[1]);
+                        g_deviceListTable.ip[2] = (dhcp_packet->data.yiaddr[2]);
+                        g_deviceListTable.ip[3] = (dhcp_packet->data.yiaddr[3]);
+                        send_msg_to_user(g_deviceListTable);
+                    }
+                }
+            }
+        }
+    }
+    return 0;
+}
