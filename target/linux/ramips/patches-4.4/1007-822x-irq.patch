diff --git a/drivers/net/ethernet/mediatek/mtk_eth_soc.c b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
index ee0462d2..5c518e93 100644
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -41,7 +41,7 @@
 #if defined(CONFIG_NET_MEDIATEK_HNAT) || defined(CONFIG_NET_MEDIATEK_HNAT_MODULE)
 #include "mtk_hnat/nf_hnat_mtk.h"
 #endif
-
+static struct mtk_eth *sg_eth;
 static int mtk_msg_level = -1;
 module_param_named(msg_level, mtk_msg_level, int, 0);
 MODULE_PARM_DESC(msg_level, "Message level (-1=defaults,0=none,...,16=all)");
@@ -255,6 +255,18 @@ void mtk_mmd_write(struct mtk_eth *eth, int addr, int devad, u16 reg,
     mutex_unlock(&eth->mii_bus->mdio_lock);
 }
 
+int mtk_soc_mmd_read(int phyad, int devad, int regad)
+{
+    struct mtk_eth *eth = sg_eth;
+    return mtk_mmd_read(eth, phyad, devad, regad);
+}
+
+void mtk_soc_mmd_write(int phyad, int devad, int regad, int val)
+{
+    struct mtk_eth *eth = sg_eth;
+    mtk_mmd_write(eth, phyad, devad, regad, val);
+}
+
 static int mtk_mdio_busy_wait(struct mtk_eth *eth)
 {
 	unsigned long t_start = jiffies;
@@ -2768,7 +2780,9 @@ static int mtk_probe(struct platform_device *pdev)
 	if (!eth)
 		return -ENOMEM;
 
-	match = of_match_device(of_mtk_match, &pdev->dev);
+    sg_eth = eth;
+
+    match = of_match_device(of_mtk_match, &pdev->dev);
 	eth->soc = (struct mtk_soc_data *)match->data;
 
 	eth->dev = &pdev->dev;
diff --git a/drivers/net/ethernet/mediatek/rtl822x/nic_rtl8226b_init.c b/drivers/net/ethernet/mediatek/rtl822x/nic_rtl8226b_init.c
index 9da0ad9f..09927979 100755
