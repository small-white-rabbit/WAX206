---
 drivers/net/ethernet/mediatek/mtk_eth_soc.c   | 18 +++++-
 .../mediatek/rtl822x/nic_rtl8226b_init.c      |  1 -
 drivers/net/phy/mtk/mt753x/mt753x.h           |  3 +
 drivers/net/phy/mtk/mt753x/mt753x_common.c    | 59 +++++++++++++++++--
 drivers/net/phy/mtk/mt753x/mt753x_mdio.c      | 58 ++++++++++++++++--
 include/linux/ssk_public.h                    |  1 +
 6 files changed, 127 insertions(+), 13 deletions(-)
