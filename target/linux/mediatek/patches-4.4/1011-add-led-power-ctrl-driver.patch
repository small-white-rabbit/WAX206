+++ b/drivers/leds/led-class.c	2020-05-14 21:07:18.015435636 +0800
@@ -74,6 +74,59 @@ static ssize_t max_brightness_show(struc
 }
 static DEVICE_ATTR_RO(max_brightness);
 
+static ssize_t power_ctl_store(struct device *dev,
+        struct device_attribute *attr, const char *buf, size_t size)
+{
+    struct led_classdev *led_cdev = dev_get_drvdata(dev);
+    unsigned long state;
+    ssize_t ret;
+
+    mutex_lock(&led_cdev->led_access);
+    
+    if (led_sysfs_is_disabled(led_cdev)) {
+        ret = -EBUSY;
+        goto unlock;
+    }
+
+    ret = kstrtoul(buf, 10, &state);
+    if (ret)
+        goto unlock;
+    
+    switch(state)
+    {
+    case 0:
+        led_cdev->flags |= LED_SUSPENDED;
+        led_set_brightness_nopm(led_cdev, 0);
+        break;
+    case 1:
+        led_cdev->flags |= LED_SUSPENDED;
+        led_set_brightness_nopm(led_cdev, 1);
+        break;
+    case 2:
+        led_cdev->flags &= ~LED_SUSPENDED;
+        led_set_brightness_nopm(led_cdev, led_cdev->brightness);
+        break;
+    default:
+        break;
+    }
+    led_cdev->state = state;
+    ret = size;
+
+unlock:
+    mutex_unlock(&led_cdev->led_access);
+    return ret;
+}
+
+static ssize_t power_ctl_show(struct device *dev,
+        struct device_attribute *attr, const char *buf, size_t size)
+{
+    struct led_classdev *led_cdev = dev_get_drvdata(dev);
+
+    return sprintf(buf, "%u\n", led_cdev->state);
+}
+
+static DEVICE_ATTR_RW(power_ctl);
+
 #ifdef CONFIG_LEDS_TRIGGERS
