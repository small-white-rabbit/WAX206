+    if (MmdPhyRead(hDevice, MMD_AN, 0, &phydata) == SUCCESS)
+    {
+        if (phydata & BIT_12)   /* AN_ENABLE */
+        {
+            phydata |= BIT_9; /* RESTART_AN */
+            MmdPhyWrite(hDevice, MMD_AN, 0, phydata);
+        }
+    }
+
+exit:
+    return status;
+}
