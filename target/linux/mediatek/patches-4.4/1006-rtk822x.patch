+static BOOL
+Rtl8226b_wait_for_bit(
+    IN HANDLE hDevice,
+    IN UINT16 dev,
+    IN UINT16 addr,
+    IN UINT16 mask,
+    IN BOOL   set,
+    IN UINT16 timeoutms)
+{
+    BOOL status = FAILURE;
+    UINT16 phydata = 0;
+
+    while (--timeoutms) {
+        status = MmdPhyRead(hDevice, dev, addr, &phydata);
+
+        if (!status)
+            goto exit;
+
+        if (!set)
+            phydata = ~phydata;
+
+        if ((phydata & mask) == mask)
+            return 1;
+
+        Sleep(1);
+    }
+
+    //phy_osal_printf("Timeout (dev=%02x addr=0x%02x mask=0x%02x timeout=%d)\n", dev, addr, mask, timeoutms);
+
+exit:
+    return 0;
+}
