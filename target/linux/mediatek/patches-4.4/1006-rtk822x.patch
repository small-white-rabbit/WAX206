+#include <linux/of_mdio.h>
+#include <linux/of_platform.h>
+#include <linux/of_gpio.h>
+#include <linux/of_net.h>
+#include <linux/of_irq.h>
+
+#include "../mtk_eth_soc.h"
+#include "../mtk_eth_dbg.h"
+#include "rtl_adapter.h"
+#include "rtl8226_typedef.h"
+
+extern struct mtk_eth *g_eth;
+
+int MmdPhyWrite(HANDLE unit, uint16_t devad, uint16_t addr, uint16_t value)
+{
+    struct mtk_eth *eth = g_eth;
+    if (eth != NULL)
+    {
+        mtk_mmd_write(eth, 7, devad, addr, value);
+    }
+    phy_osal_printf("..\b..");
+
+    return TRUE;
+}
+
+int MmdPhyRead(HANDLE unit, uint16_t devad, uint16_t addr, uint16_t *value)
+{
+    struct mtk_eth *eth = g_eth;
+    if (eth != NULL)
+    {
+        int val = mtk_mmd_read(eth, 7, devad, addr);
+        *value = (uint16_t)val;
+    }
+    phy_osal_printf("..\b..");
+
+    return TRUE;
+}
