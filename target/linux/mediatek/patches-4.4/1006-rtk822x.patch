+    {
+        phydata0 |= (BIT_2 | BIT_9);
+        phydata1 |= BIT_9;
+    }
+    else
+    {
+        phydata0 &= (~(BIT_2 | BIT_9));
+        phydata1 &= (~BIT_9);
+    }
+
+    status = MmdPhyWrite(hDevice, MMD_VEND2, 0xA442, phydata0);
+    if (status != SUCCESS)
+        goto exit;
+
+    status = MmdPhyWrite(hDevice, MMD_VEND2, 0xA428, phydata1);
+    if (status != SUCCESS)
+        goto exit;
+
+exit:
+    return status;
+}
+
