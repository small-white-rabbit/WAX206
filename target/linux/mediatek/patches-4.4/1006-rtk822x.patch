+BOOLEAN
+Rtl8226b_enable_set(
+    IN HANDLE hDevice,
+    IN BOOL Enable
+    )
+{
+    BOOL status = FAILURE;
+    UINT16 phydata = 0;
+
+    status = MmdPhyRead(hDevice, MMD_PMAPMD, 0, &phydata);
+    if (status != SUCCESS)
+        goto exit;
+
+    if (Enable)
+        phydata &= (~BIT_11);        // set as 0
+    else
+        phydata |= BIT_11;            // set as 1
+
+
+    status = MmdPhyWrite(hDevice, MMD_PMAPMD, 0, phydata);
+    if (status != SUCCESS)
+        goto exit;
+
+exit:
+    return status;
