+BOOLEAN
+Rtl8226b_gigaLiteEnable_set(
+    IN HANDLE hDevice,
+    IN BOOL Enable
+    )
+{
+    BOOL status = FAILURE;
+    UINT16 phydata0 = 0, phydata1 = 0;
+
+    status = MmdPhyRead(hDevice, MMD_VEND2, 0xA442, &phydata0);
