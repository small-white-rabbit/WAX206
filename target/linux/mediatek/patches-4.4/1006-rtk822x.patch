+    default:
+        status = FAILURE;
+        goto exit;
+    }
+
+    status = MmdPhyWrite(hDevice, MMD_AN, 32, phydata);
+    if (status != SUCCESS)
+        goto exit;
+
+exit:
+    return status;
+}
