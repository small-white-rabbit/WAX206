From 26f58cad073b9f34bb8c7b2139eadb8e2f565178 Mon Sep 17 00:00:00 2001
From: hudawei <hudawei@twsh.com>
Date: Fri, 27 Nov 2020 18:21:29 +0800
Subject: [PATCH] link time stamp

---
 drivers/net/phy/mtk/mt753x/mt753x.h        |  3 +
 drivers/net/phy/mtk/mt753x/mt753x_common.c | 72 ++++++++++++++++++++--
 drivers/net/phy/mtk/mt753x/mt753x_mdio.c   |  2 +
 3 files changed, 73 insertions(+), 4 deletions(-)

diff --git a/drivers/net/phy/mtk/mt753x/mt753x.h b/drivers/net/phy/mtk/mt753x/mt753x.h
index c1623526..6fe9283b 100644
--- a/drivers/net/phy/mtk/mt753x/mt753x.h
+++ b/drivers/net/phy/mtk/mt753x/mt753x.h
@@ -153,6 +153,9 @@ void mt753x_tr_write(struct gsw_mt753x *gsw, int addr, u8 ch, u8 node, u8 daddr,
 void mt753x_irq_worker(struct work_struct *work);
 void mt753x_irq_enable(struct gsw_mt753x *gsw);
 
+int mt753x_debug_proc_init(void);
+void mt753x_debug_proc_exit(void);
+
 /* MDIO Indirect Access Registers */
 #define MII_MMD_ACC_CTL_REG		0x0d
 #define MMD_CMD_S			14
diff --git a/drivers/net/phy/mtk/mt753x/mt753x_common.c b/drivers/net/phy/mtk/mt753x/mt753x_common.c
index c836a636..87955bdb 100644
--- a/drivers/net/phy/mtk/mt753x/mt753x_common.c
+++ b/drivers/net/phy/mtk/mt753x/mt753x_common.c
@@ -10,10 +10,20 @@
 
 #include <linux/kernel.h>
 #include <linux/delay.h>
+#include <linux/time.h>
+#include <linux/timex.h>
+#include <linux/proc_fs.h>
+#include <linux/ktime.h>
 
 #include "mt753x.h"
 #include "mt753x_regs.h"
 
+static struct proc_dir_entry *proc_dir = NULL;
+static struct proc_dir_entry *proc_link_dir = NULL;
+#define MT753X_GSW_DIR "mtk_gsw"
+#define MT753X_GSW_LINK_ENTRY "link_time_stamp"
+__kernel_time_t link_sec[MT753X_NUM_PORTS];
+
 void mt753x_irq_enable(struct gsw_mt753x *gsw)
 {
 	u32 val;
@@ -35,10 +45,11 @@ static void display_port_link_status(struct gsw_mt753x *gsw, u32 port)
 {
 	u32 pmsr, speed_bits;
 	const char *speed;
+	struct timespec tp;
 
 	pmsr = mt753x_reg_read(gsw, PMSR(port));
 
-	speed_bits = (pmsr & MAC_SPD_STS_M) >> MAC_SPD_STS_S;
+    speed_bits = (pmsr & MAC_SPD_STS_M) >> MAC_SPD_STS_S;
 
 	switch (speed_bits) {
 	case MAC_SPD_10:
@@ -56,10 +67,19 @@ static void display_port_link_status(struct gsw_mt753x *gsw, u32 port)
 	}
 
 	if (pmsr & MAC_LNK_STS) {
-	dev_info(gsw->dev, "Port %d Link is Up - %s/%s\n",
-		 port, speed, (pmsr & MAC_DPX_STS) ? "Full" : "Half");
-	} else {
+		dev_info(gsw->dev, "Port %d Link is Up - %s/%s\n",
+			port, speed, (pmsr & MAC_DPX_STS) ? "Full" : "Half");
+		get_monotonic_boottime(&tp);
+		if (port < MT753X_NUM_PORTS)
+		{
+			link_sec[port] = tp.tv_sec + (tp.tv_nsec ? 1 : 0);
+		}
+    } else {
 		dev_info(gsw->dev, "Port %d Link is Down\n", port);
+		if (port < MT753X_NUM_PORTS)
+		{
+			link_sec[port] = 0;
+		}
 	}
 }
 
@@ -92,3 +112,47 @@ void mt753x_irq_worker(struct work_struct *work)
 
 	enable_irq(gsw->irq);
 }
+
+
+static int link_time_stamp_read(struct seq_file *seq, void *v)
+{
+    int i = 0;
+    for (i = 0; i < MT753X_NUM_PORTS; i++)
+    {
+		seq_printf(seq, "%ld ", link_sec[i]);
+	}
+    return 0;
+}
+
+static int link_time_stamp_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, link_time_stamp_read, 0);
+}
+
+static const struct file_operations mt753x_link_stamp_fops = {
+    .owner = THIS_MODULE,
+    .open = link_time_stamp_open,
+    .read = seq_read,
+    .llseek = seq_lseek,
+    .release = single_release};
+
+int mt753x_debug_proc_init(void)
+{
+
+    if (!proc_dir)
+        proc_dir = proc_mkdir(MT753X_GSW_DIR, NULL);
+
+    proc_link_dir =
+        proc_create(MT753X_GSW_LINK_ENTRY, 0, proc_dir, &mt753x_link_stamp_fops);
+
+    if (!proc_link_dir)
+        printk("!! FAIL to create %s PROC !!\n", MT753X_GSW_LINK_ENTRY);
+
+    return 0;
+}
+
+void mt753x_debug_proc_exit(void)
+{
+    if (proc_dir)
+        remove_proc_entry(MT753X_GSW_DIR, proc_dir);
+}
diff --git a/drivers/net/phy/mtk/mt753x/mt753x_mdio.c b/drivers/net/phy/mtk/mt753x/mt753x_mdio.c
index f6570741..60ab0048 100644
--- a/drivers/net/phy/mtk/mt753x/mt753x_mdio.c
+++ b/drivers/net/phy/mtk/mt753x/mt753x_mdio.c
@@ -848,6 +848,7 @@ static int __init mt753x_init(void)
 	ret = platform_driver_register(&mt753x_driver);
 
 	mt753x_nl_init();
+	mt753x_debug_proc_init();
 
 	return ret;
 }
@@ -856,6 +857,7 @@ module_init(mt753x_init);
 static void __exit mt753x_exit(void)
 {
 	mt753x_nl_exit();
+	mt753x_debug_proc_exit();
 
 	platform_driver_unregister(&mt753x_driver);
 }
-- 
2.17.1

